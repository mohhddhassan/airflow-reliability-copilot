# Copy this file to .env and fill in the values you need.

# LLM provider for the Common AI Provider. One connection type
# ("pydanticai") works for every backend -- see AIRFLOW_CONN_PYDANTICAI_DEFAULT
# in docker-compose.yml. To switch providers, update requirements.txt's
# extra ([google] -> [anthropic]/[openai]) and the model string there:
#   google    -> "google:gemini-3.6-flash"
#   anthropic -> "anthropic:claude-sonnet-4-5"
#   openai    -> "openai:gpt-5.3"

GOOGLE_API_KEY=your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Optional: real push notification when a HITL approval is needed.
# Google Chat space -> space name -> Apps & integrations -> Webhooks ->
# Add webhook -> copy the URL. Leave unset to skip this notifier.
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...
